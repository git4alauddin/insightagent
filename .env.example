APP_NAME=InsightAgent
APP_VERSION=v7
APP_ENV=development
LOG_LEVEL=INFO
DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_UPLOADS_PER_MINUTE=5
RATE_LIMIT_WINDOW_SECONDS=60

LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30

API_KEY=your-service-api-key-here

CSV_MAX_FILE_SIZE_MB=10
CSV_MAX_ROWS=100000
CSV_MAX_COLUMNS=200
UPLOAD_DIR=uploads

DOCUMENT_MAX_FILE_SIZE_MB=20
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.txt,.md
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=120
